<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <defaultDocument>
      <files>
        <clear />
        <add value="index.asp" />
      </files>
    </defaultDocument>
    <directoryBrowse enabled="false" />
    <httpErrors existingResponse="PassThrough" />
    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
      </customHeaders>
    </httpProtocol>
    <security>
      <requestFiltering>
        <fileExtensions>
          <add fileExtension=".sql" allowed="false" />
          <add fileExtension=".md" allowed="false" />
          <add fileExtension=".ps1" allowed="false" />
          <add fileExtension=".vbs" allowed="false" />
        </fileExtensions>
        <hiddenSegments>
          <add segment="tests" />
        </hiddenSegments>
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
